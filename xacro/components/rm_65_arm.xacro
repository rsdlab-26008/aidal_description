<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="rm_65" params="prefix yaw_offset:=0">


<!-- link6_type -->
<xacro:arg name="link6_type" default="Link6" />
<!-- arg->property -->
<xacro:property name="link6_type" value="$(arg link6_type)" />
  <!-- Inertial matrix -->
 
  <!-- ///////////////////////////////////////   bottom_joint   ////////////////////////////////////////// -->
  <!-- <joint name="bottom_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="${prefix}arm_root"/>
    <child link="bottom_link"/>
  </joint>
  <link name="bottom_link">
    <visual>
      <origin xyz=" 0 0 -0.02"  rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.02" />
      </geometry>
      <material name="Brown" />
    </visual>
    <collision>
      <origin xyz=" 0 0 0"  rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.02" />
      </geometry>
    </collision>
  </link> -->
  
  <link name="${prefix}arm_root">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <link
    name="${prefix}link1">
    <inertial>
      <origin
        xyz="1.2226305431569E-08 0.0211079974844683 -0.0251854220842269"
        rpy="0 0 0" />
      <mass
        value="0.593563443690403" />
      <inertia
        ixx="0.00126614120341847"
        ixy="-1.294980943835e-08"
        ixz="-9.80120923066996e-09"
        iyy="0.00118168178300364"
        iyz="-0.00021121727444415"
        izz="0.00056135241627747" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/rm_65_arm/link1.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/rm_65_arm/link1.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="${prefix}joint1"
    type="revolute">
    <origin
      xyz="0 0 0"
      rpy="0 0 ${yaw_offset}" />
    <parent
      link="${prefix}arm_root" />
    <child
      link="${prefix}link1" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3.1"
      upper="3.1"
      effort="60"
      velocity="3.14" />
  </joint>
  <link
    name="${prefix}link2">
    <inertial>
      <origin
        xyz="0.152256463426163 4.75383656106654E-07 -0.00620260383607792"
        rpy="0 0 0" />
      <mass
        value="0.864175046869043" />
      <inertia
        ixx="0.00089150298478414"
        ixy="-2.23268489334765e-08"
        ixz="0.00156246461035015"
        iyy="0.00733754343083901"
        iyz="6.28110889329165e-09"
        izz="0.00697869103915473" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/rm_65_arm/link2.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/rm_65_arm/link2.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="${prefix}joint2"
    type="revolute">
    <origin
      xyz="0 0 0"
      rpy="1.5708 -1.5708 0" />
    <parent
      link="${prefix}link1" />
    <child
      link="${prefix}link2" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-2.268"
      upper="2.268"
      effort="60"
      velocity="3.14" />
  </joint>
  <link
    name="${prefix}link3">
    <inertial>
      <origin
        xyz="5.05312670989961E-06 -0.0595925663694732 0.010569069212336"
        rpy="0 0 0" />
      <mass
        value="0.289633681624654" />
      <inertia
        ixx="0.00063737100450158"
        ixy="-7.05261293649751e-08"
        ixz="-3.86643272239426e-08"
        iyy="0.00015648388095025"
        iyz="-0.00014461035994916"
        izz="0.000614178164773085" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/rm_65_arm/link3.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/rm_65_arm/link3.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="${prefix}joint3"
    type="revolute">
    <origin
      xyz="0.256 0 0"
      rpy="0 0 1.5708" />
    <parent
      link="${prefix}link2" />
    <child
      link="${prefix}link3" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-2.355"
      upper="2.355"
      effort="30"
      velocity="3.92" />
  </joint>
  <link
    name="${prefix}link4">
    <inertial>
      <origin
        xyz="1.15516617405898E-06 -0.0180424468598241 -0.0215394748352687"
        rpy="0 0 0" />
      <mass
        value="0.239419768320061" />
      <inertia
        ixx="0.000285938919722783"
        ixy="3.07101359163101e-09"
        ixz="-2.21994118981953e-09"
        iyy="0.000262727540304212"
        iyz="4.4236583260078e-05"
        izz="0.000119888082791859" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/rm_65_arm/link4.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/rm_65_arm/link4.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="${prefix}joint4"
    type="revolute">
    <origin
      xyz="0 -0.21 0"
      rpy="1.5708 0 0" />
    <parent
      link="${prefix}link3" />
    <child
      link="${prefix}link4" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3.1"
      upper="3.1"
      effort="10"
      velocity="3.92" />
  </joint>
  <link
    name="${prefix}link5">
    <inertial>
      <origin
        xyz="3.19794786262152E-06 -0.0593808368101458 0.00736804250989326"
        rpy="0 0 0" />
      <mass
        value="0.218799761431678" />
      <inertia
        ixx="0.000350540363914072"
        ixy="-3.41781619975602e-08"
        ixz="-1.77056457224373e-08"
        iyy="0.000104927867487581"
        iyz="-7.82431228461971e-05"
        izz="0.000334482418423629" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/rm_65_arm/link5.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rm_description/meshes/rm_65_arm/link5.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="${prefix}joint5"
    type="revolute">
    <origin
      xyz="0 0 0"
      rpy="-1.5708 0 0" />
    <parent
      link="${prefix}link4" />
    <child
      link="${prefix}link5" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-2.233"
      upper="2.233"
      effort="10"
      velocity="3.92" />
  </joint>
  
  
  
  


    <link
      name="${prefix}link6">
      <inertial>
        <origin
          xyz="0.000714234511756999 -0.000396718732824521 -0.0126723660946126"
          rpy="0 0 0" />
        <mass
          value="0.1" />
        <inertia
          ixx="0.0001"
          ixy="-1.32505200276849e-06"
          ixz="-2.5845091522508e-08"
          iyy="0.0001"
          iyz="3.39471452125439e-09"
          izz="0.0001" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://rm_description/meshes/rm_65_arm/link6.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="1 1 1 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://rm_description/meshes/rm_65_arm/link6.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="${prefix}joint6"
      type="revolute">
      <origin
        xyz="0 -0.144 0"
        rpy="1.5708 0 0" />
      <parent
        link="${prefix}link5" />
      <child
        link="${prefix}link6" />
      <axis
