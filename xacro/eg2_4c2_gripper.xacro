<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="eg2_4c2_gripper" params="prefix parent *origin">
    <joint name="${prefix}gripper_fix" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${prefix}4C2_baselink"/>
    </joint>

    <link name="${prefix}4C2_baselink">
      <inertial>
        <origin xyz="1.5645E-05 -4.1838E-06 0.038" rpy="0 0 0" />
        <mass value="0.072633" />
        <inertia ixx="5.095E-05" ixy="-7.3167E-13" ixz="2.0229E-08" iyy="6.0883E-05" iyz="-4.5583E-09" izz="1.933E-05" />
      </inertial>
      <visual>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_baselink.STL" /></geometry>
        <material name=""><color rgba="0.75294 0.75294 0.75294 1" /></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_baselink.STL" /></geometry>
      </collision>
    </link>

    <link name="${prefix}4C2_Link1">
      <inertial>
        <origin xyz="0.0087669 0.009 0.013992" rpy="0 0 0" />
        <mass value="0.0024292" />
        <inertia ixx="5.1061E-07" ixy="-8.6739E-19" ixz="-2.508E-07" iyy="5.7398E-07" iyz="-1.3667E-18" izz="2.6747E-07" />
      </inertial>
      <visual>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link1.STL" /></geometry>
        <material name=""><color rgba="0.75294 0.75294 0.75294 1" /></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link1.STL" /></geometry>
      </collision>
    </link>
    <joint name="${prefix}4C2_Joint1" type="revolute">
      <origin xyz="-0.04 -0.009 0.079" rpy="0 0 0" />
      <parent link="${prefix}4C2_baselink" />
      <child link="${prefix}4C2_Link1" />
      <axis xyz="0 -1 0" />
      <limit lower="0" upper="0.82" effort="1" velocity="1" />
    </joint>

    <link name="${prefix}4C2_Link5">
      <inertial>
        <origin xyz="0.011864 0.006 0.011367" rpy="0 0 0" />
        <mass value="0.0045068" />
        <inertia ixx="5.1288E-07" ixy="-9.8137E-14" ixz="-9.4703E-08" iyy="5.3203E-07" iyz="-6.212E-14" izz="2.009E-07" />
      </inertial>
      <visual>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link5.STL" /></geometry>
        <material name=""><color rgba="0.75294 0.75294 0.75294 1" /></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link5.STL" /></geometry>
      </collision>
    </link>
    <joint name="${prefix}4C2_Joint5" type="revolute">
      <origin xyz="0.0223 0.003 0.035591" rpy="0 0 0" />
      <parent link="${prefix}4C2_Link1" />
      <child link="${prefix}4C2_Link5" />
      <axis xyz="0 1 0" />
      <limit lower="0" upper="0.82" effort="1" velocity="1" />
    </joint>

    <link name="${prefix}4C2_Link2">
      <inertial>
        <origin xyz="0.0087435 0.009 0.013955" rpy="0 0 0" />
        <mass value="0.0038971" />
        <inertia ixx="5.6941E-07" ixy="-1.0711E-18" ixz="-2.6891E-07" iyy="6.2305E-07" iyz="-1.6845E-18" izz="3.0871E-07" />
      </inertial>
      <visual>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link2.STL" /></geometry>
        <material name=""><color rgba="0.75294 0.75294 0.75294 1" /></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link2.STL" /></geometry>
      </collision>
    </link>
    <joint name="${prefix}4C2_Joint2" type="revolute">
      <origin xyz="-0.03 -0.009 0.081" rpy="0 0 0" />
      <parent link="${prefix}4C2_baselink" />
      <child link="${prefix}4C2_Link2" />
      <axis xyz="0 -1 0" />
      <limit lower="0" upper="0.82" effort="1" velocity="1" />
    </joint>

    <link name="${prefix}4C2_Link3">
      <inertial>
        <origin xyz="-0.0087435 0.009 0.013955" rpy="0 0 0" />
        <mass value="0.0038971" />
        <inertia ixx="5.6941E-07" ixy="1.0666E-18" ixz="2.6891E-07" iyy="6.2305E-07" iyz="-1.8084E-18" izz="3.0871E-07" />
      </inertial>
      <visual>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link3.STL" /></geometry>
        <material name=""><color rgba="0.75294 0.75294 0.75294 1" /></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link3.STL" /></geometry>
      </collision>
    </link>
    <joint name="${prefix}4C2_Joint3" type="revolute">
      <origin xyz="0.03 -0.009 0.081" rpy="0 0 0" />
      <parent link="${prefix}4C2_baselink" />
      <child link="${prefix}4C2_Link3" />
      <axis xyz="0 -1 0" />
      <limit lower="-0.82" upper="0" effort="1" velocity="1" />
    </joint>

    <link name="${prefix}4C2_Link4">
      <inertial>
        <origin xyz="-0.0087669 0.009 0.013992" rpy="0 0 0" />
        <mass value="0.0024292" />
        <inertia ixx="5.1061E-07" ixy="-9.5279E-19" ixz="2.508E-07" iyy="5.7398E-07" iyz="7.6863E-19" izz="2.6747E-07" />
      </inertial>
      <visual>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link4.STL" /></geometry>
        <material name=""><color rgba="0.75294 0.75294 0.75294 1" /></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link4.STL" /></geometry>
      </collision>
    </link>
    <joint name="${prefix}4C2_Joint4" type="revolute">
      <origin xyz="0.04 -0.009 0.079" rpy="0 0 0" />
      <parent link="${prefix}4C2_baselink" />
      <child link="${prefix}4C2_Link4" />
      <axis xyz="0 -1 0" />
      <limit lower="-0.82" upper="0" effort="1" velocity="1" />
    </joint>

    <link name="${prefix}4C2_Link6">
      <inertial>
        <origin xyz="-0.011864 0.006 0.011367" rpy="0 0 0" />
        <mass value="0.0045068" />
        <inertia ixx="5.1288E-07" ixy="-9.8137E-14" ixz="9.4703E-08" iyy="5.3203E-07" iyz="6.2119E-14" izz="2.009E-07" />
      </inertial>
      <visual>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link6.STL" /></geometry>
        <material name=""><color rgba="0.75294 0.75294 0.75294 1" /></material>
      </visual>
      <collision>
        <geometry><mesh filename="package://aidal_description/meshes/EG2-4C2/4C2_Link6.STL" /></geometry>
      </collision>
    </link>
    <joint name="${prefix}4C2_Joint6" type="revolute">
      <origin xyz="-0.0223 0.003 0.035591" rpy="0 0 0" />
      <parent link="${prefix}4C2_Link4" />
      <child link="${prefix}4C2_Link6" />
      <axis xyz="0 -1 0" />
      <limit lower="0" upper="0.82" effort="1" velocity="1" />
    </joint>

    <transmission name="${prefix}gripper_finger1_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}4C2_Joint1">
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}gripper_finger1_motor">
        <mechanicalReduction>1</mechanicalReduction>
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </actuator>
    </transmission>
    <transmission name="${prefix}gripper_finger2_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}4C2_Joint2">
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}gripper_finger2_motor">
        <mechanicalReduction>1</mechanicalReduction>
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </actuator>
    </transmission>
    <transmission name="${prefix}gripper_finger3_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}4C2_Joint3">
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}gripper_finger3_motor">
        <mechanicalReduction>1</mechanicalReduction>
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </actuator>
    </transmission>
    <transmission name="${prefix}gripper_finger4_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}4C2_Joint4">
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}gripper_finger4_motor">
        <mechanicalReduction>1</mechanicalReduction>
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </actuator>
    </transmission>
    <transmission name="${prefix}gripper_finger5_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}4C2_Joint5">
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}gripper_finger5_motor">
        <mechanicalReduction>1</mechanicalReduction>
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </actuator>
    </transmission>
    <transmission name="${prefix}gripper_finger6_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}4C2_Joint6">
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}gripper_finger6_motor">
        <mechanicalReduction>1</mechanicalReduction>
        <hardwareInterface>PositionJointInterface</hardwareInterface>
      </actuator>
    </transmission>
  
  </xacro:macro>
</robot>